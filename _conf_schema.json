{
  "search": {
    "type": "object",
    "description": "网页搜索",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用网页搜索",
        "default": true
      },
      "mode": {
        "type": "string",
        "description": "API 来源",
        "default": "current",
        "options": [
          "current",
          "provider",
          "manual"
        ],
        "hint": "当前会话供应商：沿用当前会话所选供应商；指定供应商：固定使用下方所选供应商；手动配置：在插件控制台填写 API 地址与密钥。",
        "labels": [
          "当前会话供应商",
          "指定供应商",
          "手动配置"
        ]
      },
      "provider_id": {
        "type": "string",
        "description": "指定 AstrBot 供应商",
        "default": "",
        "_special": "select_provider",
        "hint": "仅在「指定供应商」模式下生效，从已有供应商中选择。",
        "condition": {
          "mode": "provider"
        }
      },
      "base_url": {
        "type": "string",
        "description": "手动 API Base URL",
        "default": "",
        "invisible": true
      },
      "keys": {
        "type": "list",
        "description": "手动 API Key 列表",
        "default": [],
        "secret": true,
        "hint": "仅手动配置模式生效。可填明文 Key 或 $NAME / ${NAME} / env:NAME 环境变量引用，切勿在聊天中发送。",
        "invisible": true
      },
      "model": {
        "type": "string",
        "description": "搜索模型 ID",
        "default": "",
        "hint": "留空则继承所选供应商模型；手动配置模式需明确填写支持搜索的模型 ID。"
      },
      "host_model": {
        "type": "string",
        "description": "Responses 宿主模型",
        "default": "",
        "invisible": true
      },
      "protocol": {
        "type": "string",
        "description": "接口协议",
        "default": "auto",
        "options": [
          "auto",
          "alpha",
          "responses"
        ],
        "invisible": true
      },
      "service_type": {
        "type": "string",
        "description": "入口服务类型",
        "default": "auto",
        "options": [
          "auto",
          "openai",
          "newapi",
          "sub2api",
          "unknown"
        ],
        "invisible": true
      },
      "proxy": {
        "type": "string",
        "description": "代理地址",
        "default": "",
        "invisible": true
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒，0 沿用供应商）",
        "default": 0,
        "invisible": true
      },
      "headers": {
        "type": "dict",
        "description": "附加请求头",
        "default": {},
        "hint": "请填写 JSON 对象（如 {\"X-Custom\": \"value\"}），勿将整个对象包成字符串。",
        "invisible": true
      },
      "extra_body": {
        "type": "dict",
        "description": "附加请求体",
        "default": {},
        "hint": "用 JSON 对象填写所选接口允许的扩展字段。Alpha Search 使用固定请求体。",
        "invisible": true
      },
      "paths": {
        "type": "dict",
        "description": "接口路径覆盖",
        "default": {},
        "hint": "用 JSON 对象指定接口路径，如 {\"responses\": \"/v1/responses\"}。",
        "invisible": true
      },
      "max_queries": {
        "type": "int",
        "description": "每次最多查询数",
        "default": 1,
        "invisible": true
      },
      "max_results": {
        "type": "int",
        "description": "最多结果数",
        "default": 3,
        "invisible": true
      },
      "default_results": {
        "type": "int",
        "description": "默认结果数",
        "default": 3,
        "invisible": true
      },
      "max_tool_calls": {
        "type": "int",
        "description": "上游搜索工具次数上限",
        "default": 1,
        "invisible": true
      },
      "trigger_policy": {
        "type": "string",
        "description": "搜索触发策略",
        "default": "explicit",
        "options": [
          "on_demand",
          "explicit"
        ],
        "labels": [
          "按需搜索",
          "仅明确请求搜索"
        ],
        "invisible": true
      },
      "snippet_chars": {
        "type": "int",
        "description": "每条搜索结果摘要字符上限",
        "default": 240,
        "invisible": true
      },
      "response_chars": {
        "type": "int",
        "description": "搜索回应总字符预算",
        "default": 2000,
        "invisible": true
      },
      "show_citations": {
        "type": "bool",
        "description": "向模型提供引用标记",
        "default": false,
        "hint": "仅控制工具返回给模型的数据，不强制约束模型最终回复的排版格式。",
        "invisible": true
      },
      "show_links": {
        "type": "bool",
        "description": "向模型提供来源链接",
        "default": false,
        "hint": "仅控制工具返回给模型的数据，不强制约束模型最终回复必须输出链接。",
        "invisible": true
      },
      "include_raw": {
        "type": "bool",
        "description": "包含上游原始搜索内容",
        "default": false,
        "invisible": true
      }
    }
  },
  "image": {
    "type": "object",
    "description": "图片生成与编辑",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用图片生成与编辑",
        "default": true
      },
      "mode": {
        "type": "string",
        "description": "API 来源",
        "default": "current",
        "options": [
          "current",
          "provider",
          "manual"
        ],
        "hint": "当前会话供应商：沿用当前会话所选供应商；指定供应商：固定使用下方所选供应商；手动配置：在插件控制台填写 API 地址与密钥。",
        "labels": [
          "当前会话供应商",
          "指定供应商",
          "手动配置"
        ]
      },
      "provider_id": {
        "type": "string",
        "description": "指定 AstrBot 供应商",
        "default": "",
        "_special": "select_provider",
        "hint": "仅在「指定供应商」模式下生效，从已有供应商中选择。",
        "condition": {
          "mode": "provider"
        }
      },
      "base_url": {
        "type": "string",
        "description": "手动 API Base URL",
        "default": "",
        "invisible": true
      },
      "keys": {
        "type": "list",
        "description": "手动 API Key 列表",
        "default": [],
        "secret": true,
        "hint": "仅手动配置模式生效。可填明文 Key 或 $NAME / ${NAME} / env:NAME 环境变量引用，切勿在聊天中发送。",
        "invisible": true
      },
      "model": {
        "type": "string",
        "description": "图片模型 ID（必填）",
        "default": "",
        "hint": "填写上游支持的图片模型 ID 后才能生图。留空时仍可先保存其他设置。"
      },
      "host_model": {
        "type": "string",
        "description": "Responses 宿主模型",
        "default": "",
        "hint": "用于 Responses 生图。留空时使用所选供应商的模型，手动配置时须填写。",
        "condition": {
          "protocol": "responses"
        }
      },
      "protocol": {
        "type": "string",
        "description": "接口协议",
        "default": "auto",
        "options": [
          "auto",
          "images",
          "responses"
        ],
        "invisible": true
      },
      "service_type": {
        "type": "string",
        "description": "入口服务类型",
        "default": "auto",
        "options": [
          "auto",
          "openai",
          "newapi",
          "sub2api",
          "unknown"
        ],
        "invisible": true
      },
      "proxy": {
        "type": "string",
        "description": "代理地址",
        "default": "",
        "invisible": true
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒，0 沿用供应商）",
        "default": 0,
        "invisible": true
      },
      "headers": {
        "type": "dict",
        "description": "附加请求头",
        "default": {},
        "hint": "请填写 JSON 对象（如 {\"X-Custom\": \"value\"}），勿将整个对象包成字符串。",
        "invisible": true
      },
      "extra_body": {
        "type": "dict",
        "description": "附加请求体",
        "default": {},
        "hint": "用 JSON 对象填写所选生图接口允许的扩展字段。",
        "invisible": true
      },
      "paths": {
        "type": "dict",
        "description": "接口路径覆盖",
        "default": {},
        "hint": "用 JSON 对象指定接口路径，如 {\"generations\": \"/v1/images/generations\"}。",
        "invisible": true
      },
      "max_outputs": {
        "type": "int",
        "description": "每次最多输出文件数",
        "default": 4,
        "invisible": true
      },
      "max_references": {
        "type": "int",
        "description": "最多参考图片数",
        "default": 16,
        "invisible": true
      },
      "formats": {
        "type": "list",
        "description": "允许输出格式",
        "default": [
          "png",
          "jpeg",
          "webp",
          "gif"
        ],
        "invisible": true
      },
      "sizes": {
        "type": "list",
        "description": "允许的输出尺寸（空列表表示不限制可选尺寸）",
        "default": [],
        "invisible": true
      },
      "max_pixels": {
        "type": "int",
        "description": "单帧最大像素数",
        "default": 16777216,
        "invisible": true
      },
      "max_frames_pixels": {
        "type": "int",
        "description": "GIF 总帧最大像素数",
        "default": 67108864,
        "invisible": true
      },
      "default_format": {
        "type": "string",
        "description": "默认输出格式",
        "default": "png",
        "invisible": true
      },
      "default_size": {
        "type": "string",
        "description": "默认尺寸",
        "default": "auto",
        "invisible": true
      },
      "require_at_in_group": {
        "type": "bool",
        "description": "群聊仅在 @本机器人时生效",
        "default": false,
        "hint": "开启后，群聊中的生图、改图与 GIF 请求须在当前消息中真正 @本机器人（@他人、@全体或引用消息均不满足）；私聊不受影响。",
        "invisible": true
      },
      "acceptance_template": {
        "type": "string",
        "description": "任务受理回执模板",
        "default": "已接受{kind}任务，{task_id}",
        "hint": "固定命令受理时的提示模板，支持 {kind} 与 {task_id} 占位符；不能为空，最多 300 字符。",
        "invisible": true
      },
      "presets": {
        "type": "dict",
        "description": "绘图预设名称与提示词模板",
        "default": {},
        "hint": "在插件控制台以 JSON 对象编辑，键为预设名称、值为提示词模板。",
        "invisible": true
      }
    }
  },
  "gif": {
    "type": "object",
    "description": "原生 GIF",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用原生 GIF",
        "default": false,
        "invisible": true
      },
      "frame_count": {
        "type": "int",
        "description": "默认 GIF 帧数",
        "default": 9,
        "invisible": true
      },
      "frame_duration_ms": {
        "type": "int",
        "description": "默认每帧时长（毫秒）",
        "default": 200,
        "invisible": true
      }
    },
    "invisible": true
  },
  "limits": {
    "type": "object",
    "description": "额度与并发",
    "items": {
      "timezone": {
        "type": "string",
        "description": "额度每日重置时区（IANA）",
        "default": "UTC",
        "invisible": true
      },
      "user_search": {
        "type": "int",
        "description": "群聊用户每日搜索额度（跨群累计）",
        "default": 20,
        "hint": "0 表示不限，正整数为每日次数上限。命令与聊天共用，按成功搜索请求计次。",
        "invisible": true
      },
      "group_search": {
        "type": "int",
        "description": "群每日搜索总额度",
        "default": 200,
        "hint": "0 表示不限，正整数为每日次数上限。命令与聊天共用，按成功搜索请求计次。",
        "invisible": true
      },
      "private_search": {
        "type": "int",
        "description": "私聊用户每日搜索额度",
        "default": 20,
        "hint": "0 表示不限，正整数为每日次数上限。命令与聊天共用，按成功搜索请求计次。",
        "invisible": true
      },
      "user_image": {
        "type": "int",
        "description": "群聊用户每日生图额度（跨群累计）",
        "default": 3,
        "hint": "0 表示不限，正整数为每日张数上限。命令与自然语言共用，按提交给上游的图片张数计次（失败与审核拒绝同样占用）。",
        "invisible": true
      },
      "group_image": {
        "type": "int",
        "description": "群每日生图总额度",
        "default": 30,
        "hint": "0 表示不限，正整数为每日张数上限。命令与自然语言共用，按提交给上游的图片张数计次（失败与审核拒绝同样占用）。",
        "invisible": true
      },
      "private_image": {
        "type": "int",
        "description": "私聊用户每日生图额度",
        "default": 3,
        "hint": "0 表示不限，正整数为每日张数上限。命令与自然语言共用，按提交给上游的图片张数计次（失败与审核拒绝同样占用）。",
        "invisible": true
      },
      "admin_exempt": {
        "type": "bool",
        "description": "管理员豁免额度",
        "default": false,
        "invisible": true
      },
      "search_concurrency": {
        "type": "int",
        "description": "搜索并发",
        "default": 4,
        "invisible": true
      },
      "image_concurrency": {
        "type": "int",
        "description": "生图并发",
        "default": 2,
        "invisible": true
      },
      "queue_size": {
        "type": "int",
        "description": "生图等待队列容量",
        "default": 20,
        "invisible": true
      },
      "user_image_concurrency": {
        "type": "int",
        "description": "每用户同时生图任务数",
        "default": 1,
        "invisible": true
      },
      "min_interval_seconds": {
        "type": "int",
        "description": "调用最小间隔（秒）",
        "default": 2,
        "invisible": true
      },
      "search_calls_per_message": {
        "type": "int",
        "description": "每消息最多搜索调用数（含首次）",
        "default": 2,
        "hint": "每条消息的搜索总次数含首次查询。插件控制台的「后续最多补查」比此值少 1。",
        "invisible": true
      }
    },
    "invisible": true
  },
  "storage": {
    "type": "object",
    "description": "文件与任务保存",
    "items": {
      "reference_ttl_seconds": {
        "type": "int",
        "description": "个人参考图缓存秒数",
        "default": 600,
        "invisible": true
      },
      "artifact_days": {
        "type": "int",
        "description": "结果保存天数",
        "default": 7,
        "invisible": true
      },
      "task_days": {
        "type": "int",
        "description": "任务记录保存天数",
        "default": 30,
        "invisible": true
      },
      "max_input_bytes": {
        "type": "int",
        "description": "单张输入大小上限（字节）",
        "default": 20971520,
        "invisible": true
      },
      "max_output_bytes": {
        "type": "int",
        "description": "单张输出大小上限（字节）",
        "default": 104857600,
        "invisible": true
      },
      "max_total_bytes": {
        "type": "int",
        "description": "结果文件总大小上限（字节）",
        "default": 2147483648,
        "invisible": true
      }
    },
    "invisible": true
  },
  "network": {
    "type": "object",
    "description": "网络与下载",
    "items": {
      "connect_timeout": {
        "type": "int",
        "description": "连接超时（秒）",
        "default": 10,
        "invisible": true
      },
      "download_timeout": {
        "type": "int",
        "description": "下载超时（秒）",
        "default": 60,
        "invisible": true
      },
      "allow_private_download_hosts": {
        "type": "list",
        "description": "允许私网下载的主机白名单",
        "default": [],
        "invisible": true
      },
      "download_attempts": {
        "type": "int",
        "description": "结果下载最多尝试次数",
        "default": 3,
        "invisible": true
      }
    },
    "invisible": true
  },
  "diagnostics": {
    "type": "object",
    "description": "诊断日志",
    "invisible": true,
    "items": {
      "enabled": {
        "type": "bool",
        "description": "保存诊断日志",
        "default": false,
        "invisible": true,
        "hint": "默认关闭。开启后滚动记录命令、工具与任务诊断信息，保存后立即生效，无需重载插件。"
      },
      "max_mb": {
        "type": "int",
        "description": "诊断日志总量上限（MB）",
        "default": 100,
        "invisible": true,
        "hint": "支持 1–10000 MB，默认 100 MB；包含当前文件与轮转备份，超限后自动清理最旧日志。"
      }
    }
  }
}
