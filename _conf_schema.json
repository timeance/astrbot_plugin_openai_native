        "description": "API 来源",
        "default": "current",
        "options": [
          "current",
          "provider",
          "manual"
        ],
        "hint": "当前会话：使用本次会话供应商；指定供应商：使用下拉所选供应商；手动配置：请在插件页面设置 API 地址与密钥。",
        "labels": [
          "当前会话供应商",
          "指定供应商",
          "手动配置"
        ]
      },
      "provider_id": {
        "type": "string",
        "description": "绑定 AstrBot 供应商",
        "default": "",
        "_special": "select_provider",
        "hint": "选择已有供应商；仅“指定供应商”模式使用。",
        "condition": {
          "mode": "provider"
        }
      },
      "base_url": {
        "type": "string",
        "description": "手动 API Base URL",
        "default": "",
        "invisible": true
      },
      "keys": {
        "type": "list",
        "description": "手动 API Key 列表",
        "default": [],
        "secret": true,
        "hint": "仅手动模式使用。每项是 Key 或完整 $NAME / ${NAME} 环境变量引用；不要贴到聊天。",
        "invisible": true
      },
      "model": {
        "type": "string",
        "description": "图片模型 ID（必填）",
        "default": "",
        "hint": "请填写上游实际可用的图片模型；留空时生图尚未就绪。Responses 生图另需宿主模型。"
      },
      "host_model": {
        "type": "string",
        "description": "Responses 宿主模型",
        "default": "",
        "hint": "仅 Responses 生图使用；协议等高级选项在插件页面设置。",
        "condition": {
          "protocol": "responses"
        }
      },
      "protocol": {
        "type": "string",
        "description": "接口协议",
        "default": "auto",
        "options": [
          "auto",
          "images",
          "responses"
        ],
        "invisible": true
      },
      "service_type": {
        "type": "string",
        "description": "入口服务类型",
        "default": "auto",
        "options": [
          "auto",
          "openai",
          "newapi",
          "sub2api",
          "unknown"
        ],
        "invisible": true
      },
      "proxy": {
        "type": "string",
        "description": "代理地址",
        "default": "",
        "invisible": true
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒，0 复用供应商）",
        "default": 0,
        "invisible": true
      },
      "headers": {
        "type": "dict",
        "description": "附加请求头",
        "default": {},
        "hint": "AstrBot 原生字典编辑器。保存为 JSON 对象；嵌套值使用 JSON 类型，不要把整个对象保存成字符串。",
        "invisible": true
      },
      "extra_body": {
        "type": "dict",
        "description": "附加请求体",
        "default": {},
        "hint": "AstrBot 原生字典编辑器。保存为 JSON 对象；嵌套值使用 JSON 类型，不要把整个对象保存成字符串。",
        "invisible": true
      },
      "paths": {
        "type": "dict",
        "description": "接口路径覆盖",
        "default": {},
        "hint": "AstrBot 原生字典编辑器。保存为 JSON 对象；嵌套值使用 JSON 类型，不要把整个对象保存成字符串。",
        "invisible": true
      },
      "max_outputs": {
        "type": "int",
        "description": "每次最多输出文件数",
        "default": 4,
        "invisible": true
      },
      "max_references": {
        "type": "int",
        "description": "最多参考图片数",
        "default": 16,
        "invisible": true
      },
      "formats": {
        "type": "list",
        "description": "允许输出格式",
        "default": [
          "png",
          "jpeg",
          "webp",
          "gif"
        ],
        "invisible": true
      },
      "sizes": {
        "type": "list",
        "description": "允许尺寸（空列表由模型决定）",
        "default": [],
        "invisible": true
      },
      "max_pixels": {
        "type": "int",
        "description": "单帧最大像素数",
        "default": 16777216,
        "invisible": true
      },
      "max_frames_pixels": {
        "type": "int",
        "description": "GIF 总帧最大像素数",
        "default": 67108864,
        "invisible": true
      },
      "default_format": {
        "type": "string",
        "description": "默认输出格式",
        "default": "png",
        "invisible": true
      },
      "default_size": {
        "type": "string",
        "description": "默认尺寸",
        "default": "auto",
        "invisible": true
      },
      "acceptance_template": {
        "type": "string",
        "description": "任务受理回执模板",
        "default": "已接受{kind}任务，{task_id}",
        "hint": "可使用 {kind} 和 {task_id}；不能为空，最多 300 字符。",
        "invisible": true
      },
      "presets": {
        "type": "dict",
        "description": "绘图预设名称与提示词模板",
        "default": {},
        "hint": "在插件专页以 JSON 对象编辑；键为预设名称，值为提示词模板。",
        "invisible": true
      }
    }
  },
  "gif": {
    "type": "object",
    "description": "原生 GIF",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用",
        "default": false,
        "invisible": true
      },
      "frame_count": {
        "type": "int",
        "description": "默认 GIF 帧数",
        "default": 9,
        "invisible": true
      },
      "frame_duration_ms": {
        "type": "int",
        "description": "默认每帧毫秒",
        "default": 200,
        "invisible": true
      }
    },
    "invisible": true
  },
  "limits": {
    "type": "object",
    "description": "额度与并发",
    "items": {
      "timezone": {
        "type": "string",
        "description": "额度日界时区（IANA）",
        "default": "UTC",
        "invisible": true
      },
      "user_search": {
        "type": "int",
        "description": "群聊用户每日搜索额度（跨群累计）",
        "default": 20,
        "hint": "0 不限，正整数为每日额度。搜索按成功请求、生图按实际输出文件结算。",
        "invisible": true
      },
      "group_search": {
        "type": "int",
        "description": "群每日搜索总额度",
        "default": 200,
        "hint": "0 不限，正整数为每日额度。搜索按成功请求、生图按实际输出文件结算。",
        "invisible": true
      },
      "private_search": {
        "type": "int",
        "description": "私聊用户每日搜索额度",
        "default": 20,
        "hint": "0 不限，正整数为每日额度。搜索按成功请求、生图按实际输出文件结算。",
        "invisible": true
      },
      "user_image": {
        "type": "int",
        "description": "群聊用户每日生图额度（跨群累计）",
        "default": 3,
        "hint": "0 不限，正整数为每日额度。搜索按成功请求、生图按实际输出文件结算。",
        "invisible": true
      },
      "group_image": {
        "type": "int",
        "description": "群每日生图总额度",
        "default": 30,
        "hint": "0 不限，正整数为每日额度。搜索按成功请求、生图按实际输出文件结算。",
        "invisible": true
      },
      "private_image": {
        "type": "int",
        "description": "私聊用户每日生图额度",
        "default": 3,
        "hint": "0 不限，正整数为每日额度。搜索按成功请求、生图按实际输出文件结算。",
        "invisible": true
      },
      "admin_exempt": {
        "type": "bool",
        "description": "管理员豁免额度",
        "default": false,
        "invisible": true
      },
      "search_concurrency": {
        "type": "int",
        "description": "搜索并发",
        "default": 4,
        "invisible": true
      },
      "image_concurrency": {
        "type": "int",
        "description": "生图并发",
        "default": 2,
        "invisible": true
      },
      "queue_size": {
        "type": "int",
        "description": "生图等待队列容量",
        "default": 20,
        "invisible": true
      },
      "user_image_concurrency": {
        "type": "int",
        "description": "每用户同时生图任务数",
        "default": 1,
        "invisible": true
      },
      "min_interval_seconds": {
        "type": "int",
        "description": "调用最小间隔（秒）",
        "default": 2,
        "invisible": true
      },
      "search_calls_per_message": {
        "type": "int",
        "description": "每消息最多搜索调用数（含首次）",
        "default": 2,
        "hint": "插件专页按后续补查次数显示，填写 1 对应此处总调用上限 2。",
        "invisible": true
      }
    },
    "invisible": true
  },
  "storage": {
    "type": "object",
    "description": "文件与任务保存",
    "items": {
      "reference_ttl_seconds": {
        "type": "int",
        "description": "个人参考图缓存秒数",
        "default": 600,
        "invisible": true
      },
      "artifact_days": {
        "type": "int",
        "description": "结果保存天数",
        "default": 7,
        "invisible": true
      },
      "task_days": {
        "type": "int",
        "description": "任务记录保存天数",
        "default": 30,
        "invisible": true
      },
      "max_input_bytes": {
        "type": "int",
        "description": "单张输入大小上限（字节）",
        "default": 20971520,
        "invisible": true
      },
      "max_output_bytes": {
        "type": "int",
        "description": "单张输出大小上限（字节）",
        "default": 104857600,
        "invisible": true
      },
      "max_total_bytes": {
        "type": "int",
        "description": "结果文件总大小上限（字节）",
        "default": 2147483648,
        "invisible": true
      }
    },
    "invisible": true
  },
  "network": {
    "type": "object",
    "description": "网络与下载",
    "items": {
      "connect_timeout": {
        "type": "int",
        "description": "连接超时（秒）",
        "default": 10,
        "invisible": true
      },
      "download_timeout": {
        "type": "int",
        "description": "下载超时（秒）",
        "default": 60,
        "invisible": true
      },
      "allow_private_download_hosts": {
        "type": "list",
        "description": "允许私网下载的主机白名单",
        "default": [],
        "invisible": true
      },
      "download_attempts": {
        "type": "int",
        "description": "结果下载最多尝试次数",
        "default": 3,
        "invisible": true
      }
    },
    "invisible": true
  }
}
