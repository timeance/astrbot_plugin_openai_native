{
  "search": {
    "type": "object",
    "description": "网页搜索",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用",
        "default": true
      },
      "mode": {
        "type": "string",
        "description": "API 来源",
        "default": "current",
        "options": [
          "current",
          "provider",
          "manual"
        ],
        "hint": "当前会话：使用本次会话供应商；指定供应商：使用下拉所选供应商；手动配置：请在插件页面设置 API 地址与密钥。",
        "labels": [
          "当前会话供应商",
          "指定供应商",
          "手动配置"
        ]
      },
      "provider_id": {
        "type": "string",
        "description": "绑定 AstrBot 供应商",
        "default": "",
        "_special": "select_provider",
        "hint": "选择已有供应商；仅“指定供应商”模式使用。",
        "condition": {
          "mode": "provider"
        }
      },
      "base_url": {
        "type": "string",
        "description": "手动 API Base URL",
        "default": "",
        "invisible": true
      },
      "keys": {
        "type": "list",
        "description": "手动 API Key 列表",
        "default": [],
        "secret": true,
        "hint": "仅手动模式使用。每项是 Key 或完整 $NAME / ${NAME} 环境变量引用；不要贴到聊天。",
        "invisible": true
      },
      "model": {
        "type": "string",
        "description": "搜索模型 ID",
        "default": "",
        "hint": "留空继承所选供应商模型；手动 API 需填写搜索宿主模型。"
      },
      "host_model": {
        "type": "string",
        "description": "Responses 宿主模型",
        "default": "",
        "invisible": true
      },
      "protocol": {
        "type": "string",
        "description": "接口协议",
        "default": "auto",
        "options": [
          "auto",
          "alpha",
          "responses"
        ],
        "invisible": true
      },
      "service_type": {
        "type": "string",
        "description": "入口服务类型",
        "default": "auto",
        "options": [
          "auto",
          "openai",
          "newapi",
          "sub2api",
          "unknown"
        ],
        "invisible": true
      },
      "proxy": {
        "type": "string",
        "description": "代理地址",
        "default": "",
        "invisible": true
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒，0 复用供应商）",
        "default": 0,
        "invisible": true
      },
      "headers": {
        "type": "dict",
        "description": "附加请求头",
        "default": {},
        "hint": "AstrBot 原生字典编辑器。保存为 JSON 对象；嵌套值使用 JSON 类型，不要把整个对象保存成字符串。",
        "invisible": true
      },
      "extra_body": {
        "type": "dict",
        "description": "附加请求体",
        "default": {},
        "hint": "AstrBot 原生字典编辑器。保存为 JSON 对象；嵌套值使用 JSON 类型，不要把整个对象保存成字符串。",
        "invisible": true
      },
      "paths": {
        "type": "dict",
        "description": "接口路径覆盖",
        "default": {},
        "hint": "AstrBot 原生字典编辑器。保存为 JSON 对象；嵌套值使用 JSON 类型，不要把整个对象保存成字符串。",
        "invisible": true
      },
      "max_queries": {
        "type": "int",
        "description": "每次最多查询数",
        "default": 1,
        "invisible": true
      },
      "max_results": {
        "type": "int",
        "description": "最多结果数",
        "default": 3,
        "invisible": true
      },
      "default_results": {
        "type": "int",
        "description": "默认结果数",
        "default": 3,
        "invisible": true
      },
      "max_tool_calls": {
        "type": "int",
        "description": "上游搜索工具次数上限",
        "default": 1,
        "invisible": true
      },
      "trigger_policy": {
        "type": "string",
        "description": "搜索触发策略",
        "default": "explicit",
        "options": ["on_demand", "explicit"],
        "labels": ["按需搜索", "仅明确请求搜索"],
        "invisible": true
      },
      "snippet_chars": {
        "type": "int",
        "description": "每条搜索结果摘要字符上限",
        "default": 240,
        "invisible": true
      },
      "response_chars": {
        "type": "int",
        "description": "搜索回应总字符预算",
        "default": 2000,
        "invisible": true
      },
      "show_citations": {
        "type": "bool",
        "description": "向模型提供引用标记",
        "default": false,
        "hint": "仅控制工具数据，不能强制模型最终回复的格式。",
        "invisible": true
      },
      "show_links": {
        "type": "bool",
        "description": "向模型提供来源链接",
        "default": false,
        "hint": "仅控制工具数据，不能强制模型最终回复包含链接。",
        "invisible": true
      },
      "include_raw": {
        "type": "bool",
        "description": "包含上游原始搜索内容",
        "default": false,
        "invisible": true
      }
    }
  },
  "image": {
    "type": "object",
    "description": "图片生成与编辑",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用",
        "default": true
      },
      "mode": {
